{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "welcome-invitados",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // Dirección del sitio principal (sin barra final)
    "MAIN_URL": "https://welcome.sistemas-97d.workers.dev"
    // Solo si protegés el Worker con el método clásico (workers.dev > Enable Cloudflare Access),
    // agregá también:
    //   "TEAM_DOMAIN": "https://TU-EQUIPO.cloudflareaccess.com",
    //   "POLICY_AUD": "el AUD de la aplicación"
    // Con la pestaña "Access" del Worker (método nuevo) no hacen falta.
  }
  // Secreto (no va en este archivo):  GUEST_LINK_SECRET  -> el mismo valor que en el Worker principal
}
